# Server Configuration
PORT=5007

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_mgmt

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
JWT_ACCESS_TOKEN_TIME_IN_MS=900000    # 15 minutes
JWT_REFRESH_TOKEN_TIME_IN_MS=28800000 # 8 hours

# CSRF Protection
CSRF_TOKEN_SECRET=your_csrf_secret_key_here
CSRF_TOKEN_TIME_IN_MS=950000 # 15 minutes + 50 seconds

# Email Configuration
MAIL_FROM_USER=noreply@yourschool.com
RESEND_API_KEY=re_your_resend_api_key_here

# Email Verification
EMAIL_VERIFICATION_TOKEN_SECRET=your_email_verification_secret_here
EMAIL_VERIFICATION_TOKEN_TIME_IN_MS=18000000 # 5 hours

# Password Setup
PASSWORD_SETUP_TOKEN_SECRET=your_password_setup_secret_here
PASSWORD_SETUP_TOKEN_TIME_IN_MS=300000 # 5 minutes

# Frontend URL (for email links)
UI_URL=http://localhost:5173

# Backend URL (for email links)
API_URL=http://localhost:5007

# Cookie Configuration
COOKIE_DOMAIN=localhost

# Environment
NODE_ENV=development 

# ---------------------------------------------------------------
# Blockchain Certificate Verification (Problem 3)
# ---------------------------------------------------------------
# Network name matching the file in /blockchain/deployments (localhost|sepolia|amoy)
BLOCKCHAIN_NETWORK=localhost
# RPC endpoint the backend uses to read/write the contract
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Private key of the authorized issuer wallet (admin) — NEVER commit real key
ISSUER_PRIVATE_KEY=your_issuer_wallet_private_key

# IPFS (Pinata) — leave PINATA_JWT empty in local dev to use mock hashing
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
